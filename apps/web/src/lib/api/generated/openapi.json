{
	"openapi": "3.1.0",
	"info": {
		"title": "Docufill API",
		"description": "Privacy-first document completion API",
		"license": {
			"name": "UNLICENSED",
			"identifier": "UNLICENSED"
		},
		"version": "0.1.0"
	},
	"paths": {},
	"components": {
		"schemas": {
			"AddTextContext": {
				"type": "object",
				"required": ["content"],
				"properties": {
					"content": {
						"type": "string"
					}
				}
			},
			"AnswerTrust": {
				"type": "string",
				"enum": ["profile", "derived", "user", "participant", "ai_draft"]
			},
			"AssignField": {
				"type": "object",
				"properties": {
					"participant_id": {
						"type": ["string", "null"],
						"format": "uuid"
					}
				}
			},
			"CompleteDocument": {
				"type": "object",
				"required": ["consent_text"],
				"properties": {
					"apply_signature_id": {
						"type": ["string", "null"],
						"format": "uuid"
					},
					"consent_text": {
						"type": "string"
					}
				}
			},
			"CompletedDocument": {
				"type": "object",
				"required": ["document_id", "status", "download_path", "document_hash"],
				"properties": {
					"document_hash": {
						"type": "string"
					},
					"document_id": {
						"type": "string",
						"format": "uuid"
					},
					"download_path": {
						"type": "string"
					},
					"status": {
						"type": "string"
					}
				}
			},
			"CompletionQueued": {
				"type": "object",
				"required": ["document_id", "status"],
				"properties": {
					"document_id": {
						"type": "string",
						"format": "uuid"
					},
					"status": {
						"type": "string"
					}
				}
			},
			"CopilotSummary": {
				"type": "object",
				"required": [
					"total_fields",
					"grounded_fields",
					"questions_needing_input",
					"ambiguous_fields",
					"signature_fields",
					"participant_sections"
				],
				"properties": {
					"ambiguous_fields": {
						"type": "integer",
						"minimum": 0
					},
					"grounded_fields": {
						"type": "integer",
						"minimum": 0
					},
					"participant_sections": {
						"type": "integer",
						"minimum": 0
					},
					"questions_needing_input": {
						"type": "integer",
						"minimum": 0
					},
					"signature_fields": {
						"type": "integer",
						"minimum": 0
					},
					"total_fields": {
						"type": "integer",
						"minimum": 0
					}
				}
			},
			"CreateDocument": {
				"type": "object",
				"required": ["subject", "original_name", "original_storage_path", "content_hash"],
				"properties": {
					"content_hash": {
						"type": "string"
					},
					"original_name": {
						"type": "string"
					},
					"original_storage_path": {
						"type": "string"
					},
					"subject": {
						"type": "string"
					}
				}
			},
			"CreateParticipant": {
				"type": "object",
				"required": ["role", "display_name", "contact", "field_ids"],
				"properties": {
					"contact": {
						"type": "string"
					},
					"display_name": {
						"type": "string"
					},
					"field_ids": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					},
					"role": {
						"type": "string"
					},
					"send_invitation": {
						"type": "boolean"
					}
				}
			},
			"CreateSignature": {
				"type": "object",
				"required": ["kind", "image_data_url"],
				"properties": {
					"image_data_url": {
						"type": "string"
					},
					"kind": {
						"type": "string"
					}
				}
			},
			"DeleteAccount": {
				"type": "object",
				"required": ["confirmation"],
				"properties": {
					"confirmation": {
						"type": "string"
					}
				}
			},
			"DocumentDetail": {
				"allOf": [
					{
						"$ref": "#/components/schemas/DocumentSummary"
					},
					{
						"type": "object",
						"required": ["fields", "copilot"],
						"properties": {
							"copilot": {
								"$ref": "#/components/schemas/CopilotSummary"
							},
							"fields": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/DocumentField"
								}
							}
						}
					}
				]
			},
			"DocumentField": {
				"type": "object",
				"required": [
					"id",
					"field_key",
					"label",
					"kind",
					"page_number",
					"x",
					"y",
					"width",
					"height",
					"alignment",
					"source",
					"source_reference_count",
					"sort_order"
				],
				"properties": {
					"alignment": {
						"type": "string"
					},
					"confidence": {
						"type": ["number", "null"],
						"format": "double"
					},
					"confirmed_at": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"field_key": {
						"type": "string"
					},
					"font_size": {
						"type": ["number", "null"],
						"format": "double"
					},
					"height": {
						"type": "number",
						"format": "double"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"instructions": {
						"type": ["string", "null"]
					},
					"kind": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"page_number": {
						"type": "integer",
						"format": "int32"
					},
					"participant_id": {
						"type": ["string", "null"],
						"format": "uuid"
					},
					"sort_order": {
						"type": "integer",
						"format": "int32"
					},
					"source": {
						"type": "string"
					},
					"source_explanation": {
						"type": ["string", "null"]
					},
					"source_reference_count": {
						"type": "integer",
						"format": "int32"
					},
					"value": {
						"type": ["string", "null"]
					},
					"value_preview": {
						"type": ["string", "null"]
					},
					"width": {
						"type": "number",
						"format": "double"
					},
					"x": {
						"type": "number",
						"format": "double"
					},
					"y": {
						"type": "number",
						"format": "double"
					}
				}
			},
			"DocumentSummary": {
				"type": "object",
				"required": [
					"id",
					"subject",
					"original_name",
					"status",
					"progress",
					"memory_consent",
					"created_at",
					"updated_at"
				],
				"properties": {
					"completed_at": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"memory_consent": {
						"type": "boolean"
					},
					"original_name": {
						"type": "string"
					},
					"page_count": {
						"type": ["integer", "null"],
						"format": "int32"
					},
					"progress": {
						"type": "integer",
						"format": "int32"
					},
					"status": {
						"type": "string"
					},
					"subject": {
						"type": "string"
					},
					"updated_at": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"DownloadUrl": {
				"type": "object",
				"required": ["url", "expires_in"],
				"properties": {
					"expires_in": {
						"type": "integer",
						"format": "int32",
						"minimum": 0
					},
					"url": {
						"type": "string"
					}
				}
			},
			"ParticipantAnswer": {
				"type": "object",
				"required": ["value"],
				"properties": {
					"value": {
						"type": "string"
					}
				}
			},
			"ParticipantAssignment": {
				"type": "object",
				"required": [
					"document_subject",
					"requester_name",
					"participant_name",
					"role",
					"status",
					"fields"
				],
				"properties": {
					"document_subject": {
						"type": "string"
					},
					"fields": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/DocumentField"
						}
					},
					"participant_name": {
						"type": "string"
					},
					"requester_name": {
						"type": "string"
					},
					"role": {
						"type": "string"
					},
					"status": {
						"type": "string"
					}
				}
			},
			"ParticipantInvitation": {
				"type": "object",
				"required": ["participant", "share_url", "invitation_sent"],
				"properties": {
					"invitation_sent": {
						"type": "boolean"
					},
					"participant": {
						"$ref": "#/components/schemas/ParticipantSummary"
					},
					"share_url": {
						"type": "string"
					}
				}
			},
			"ParticipantLanding": {
				"type": "object",
				"required": [
					"document_subject",
					"requester_name",
					"participant_name",
					"role",
					"status",
					"verification_required"
				],
				"properties": {
					"document_subject": {
						"type": "string"
					},
					"participant_name": {
						"type": "string"
					},
					"requester_name": {
						"type": "string"
					},
					"role": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"verification_required": {
						"type": "boolean"
					}
				}
			},
			"ParticipantReceipt": {
				"type": "object",
				"required": ["participant_id", "document_subject", "submitted_at", "receipt_code"],
				"properties": {
					"document_subject": {
						"type": "string"
					},
					"participant_id": {
						"type": "string",
						"format": "uuid"
					},
					"receipt_code": {
						"type": "string"
					},
					"submitted_at": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"ParticipantSession": {
				"type": "object",
				"required": ["session_token", "expires_at"],
				"properties": {
					"expires_at": {
						"type": "string",
						"format": "date-time"
					},
					"session_token": {
						"type": "string"
					}
				}
			},
			"ParticipantSummary": {
				"type": "object",
				"required": ["id", "role", "display_name", "contact_hint", "status"],
				"properties": {
					"completed_at": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"contact_hint": {
						"type": "string"
					},
					"display_name": {
						"type": "string"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"role": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"token_expires_at": {
						"type": ["string", "null"],
						"format": "date-time"
					}
				}
			},
			"Profile": {
				"type": "object",
				"required": ["id", "onboarding_completed", "created_at", "updated_at"],
				"properties": {
					"avatar_url": {
						"type": ["string", "null"]
					},
					"created_at": {
						"type": "string",
						"format": "date-time"
					},
					"display_name": {
						"type": ["string", "null"]
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"onboarding_completed": {
						"type": "boolean"
					},
					"updated_at": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"ProfileFact": {
				"type": "object",
				"required": [
					"id",
					"namespace",
					"fact_key",
					"value_type",
					"sensitivity",
					"source_type",
					"confirmed_at",
					"usage_count"
				],
				"properties": {
					"confirmed_at": {
						"type": "string",
						"format": "date-time"
					},
					"fact_key": {
						"type": "string"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"namespace": {
						"type": "string"
					},
					"sensitivity": {
						"type": "string"
					},
					"source_document_id": {
						"type": ["string", "null"],
						"format": "uuid"
					},
					"source_type": {
						"type": "string"
					},
					"usage_count": {
						"type": "integer",
						"format": "int64"
					},
					"value_preview": {
						"type": ["string", "null"]
					},
					"value_type": {
						"type": "string"
					}
				}
			},
			"ProfileVault": {
				"type": "object",
				"required": ["profile", "facts"],
				"properties": {
					"facts": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ProfileFact"
						}
					},
					"profile": {
						"$ref": "#/components/schemas/Profile"
					},
					"signature": {
						"oneOf": [
							{
								"type": "null"
							},
							{
								"$ref": "#/components/schemas/SignatureSummary"
							}
						]
					}
				}
			},
			"SetMemoryConsent": {
				"type": "object",
				"required": ["enabled"],
				"properties": {
					"approved_field_ids": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uuid"
						}
					},
					"enabled": {
						"type": "boolean"
					}
				}
			},
			"SignatureSummary": {
				"type": "object",
				"required": ["id", "kind", "version", "created_at"],
				"properties": {
					"created_at": {
						"type": "string",
						"format": "date-time"
					},
					"id": {
						"type": "string",
						"format": "uuid"
					},
					"kind": {
						"type": "string"
					},
					"revoked_at": {
						"type": ["string", "null"],
						"format": "date-time"
					},
					"version": {
						"type": "integer",
						"format": "int32"
					}
				}
			},
			"UpdateFieldAnswer": {
				"type": "object",
				"required": ["value", "source"],
				"properties": {
					"confirmed": {
						"type": "boolean"
					},
					"source": {
						"$ref": "#/components/schemas/AnswerTrust"
					},
					"value": {
						"type": "string"
					}
				}
			},
			"UpdateFieldLayout": {
				"type": "object",
				"required": ["x", "y", "width", "height", "alignment"],
				"properties": {
					"alignment": {
						"type": "string"
					},
					"font_size": {
						"type": ["number", "null"],
						"format": "double"
					},
					"height": {
						"type": "number",
						"format": "double"
					},
					"width": {
						"type": "number",
						"format": "double"
					},
					"x": {
						"type": "number",
						"format": "double"
					},
					"y": {
						"type": "number",
						"format": "double"
					}
				}
			},
			"UpdateProfile": {
				"type": "object",
				"properties": {
					"display_name": {
						"type": ["string", "null"]
					},
					"onboarding_completed": {
						"type": ["boolean", "null"]
					}
				}
			},
			"UpsertProfileFact": {
				"type": "object",
				"required": ["namespace", "fact_key", "value"],
				"properties": {
					"fact_key": {
						"type": "string"
					},
					"namespace": {
						"type": "string"
					},
					"sensitivity": {
						"type": "string"
					},
					"source_document_id": {
						"type": ["string", "null"],
						"format": "uuid"
					},
					"value": {
						"type": "string"
					},
					"value_type": {
						"type": "string"
					}
				}
			},
			"VerifyParticipant": {
				"type": "object",
				"required": ["code"],
				"properties": {
					"code": {
						"type": "string"
					}
				}
			}
		}
	}
}
