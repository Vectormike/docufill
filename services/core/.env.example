APP_ENV=development
API_BIND=127.0.0.1:8080
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
DOCUMENTS_BUCKET=documents
SIGNATURES_BUCKET=signatures
CONTEXT_BUCKET=document-context
ENCRYPTION_KEY=base64-encoded-32-byte-key
PDFIUM_LIB_PATH=/absolute/path/to/pdfium/library/directory
UNICODE_FONT_PATH=/absolute/path/to/NotoSans-Regular.ttf
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
PUBLIC_APP_URL=http://localhost:5173
EMAIL_API_KEY=
EMAIL_FROM=Docufill <invites@example.com>
PRIVACY_CONTACT_EMAIL=privacy@example.com
# Required as true before APP_ENV=production:
DPIA_COMPLETED=false
LEGAL_REVIEW_APPROVED=false
AI_DATA_PROCESSING_TERMS_APPROVED=false
RUST_LOG=docufill_core=info,tower_http=info

