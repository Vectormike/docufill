# Public URLs. Use http://localhost and APP_DOMAIN=:80 for a first local deploy.
# For a real host, point DNS at this machine first, then use https://your.domain.
APP_DOMAIN=:80
PUBLIC_APP_URL=http://localhost
PUBLIC_API_URL=http://localhost
ACME_EMAIL=you@example.com

# Browser-safe Supabase values
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_PRIVACY_EMAIL=privacy@example.com

# API / worker. Use a direct Postgres URI (port 5432, sslmode=require) for migrations.
APP_ENV=development
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DOCUMENTS_BUCKET=documents
SIGNATURES_BUCKET=signatures
CONTEXT_BUCKET=document-context
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
EMAIL_API_KEY=
EMAIL_FROM="Docufill <invites@example.com>"
PRIVACY_CONTACT_EMAIL=privacy@example.com
DPIA_COMPLETED=false
LEGAL_REVIEW_APPROVED=false
AI_DATA_PROCESSING_TERMS_APPROVED=false
RUST_LOG=docufill_core=info,tower_http=info
